<mxfile>
  <diagram id="Z6qWQ9yF3vnwDZCR1FNE" name="Page-1">
    <mxGraphModel dx="2597" dy="613" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="81" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;Objective: To compare a Random Model (baseline) against Singular Value Decomposition (SVD) and Deep Neural Network (DNN).&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Method:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Train Random Model (no tuning), SVD (default settings), and DNN on training set.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Perform hyperparameter tuning for DNN on the validation set to optimise accuracy.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Evaluate all 3 models on test set using accuracy metrics.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Conduct hypothesis test to determine if SVD and DNN significantly outpeform Random model.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Goal: To conclude that SVD and DNN are significantly better than Random model.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Output: Accuracy scores and p-values from hypothesis test.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="-820" y="30" width="814" height="196" as="geometry" />
        </mxCell>
        <mxCell id="82" value="&lt;font style=&quot;font-size: 10px; color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Level 1: Baseline Comparisons&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99CCFF;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="-771" y="13" width="730" height="17" as="geometry" />
        </mxCell>
        <mxCell id="83" value="&lt;font style=&quot;font-size: 10px; color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;Level 2: Weighted Vs. Unweighted DNN&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF66B3;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="-774" y="275" width="730" height="17" as="geometry" />
        </mxCell>
        <mxCell id="84" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;Objective: To compare DNN performance on unweighted tracks vs. weighted tracks (weights emphasise recent tracts as more reflective of user taste.&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Method:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Use DNN with Level 1&#39;s tuned hyperparameter (no further hyperparameter tuning).&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Weighted tracks: Derived via a weighted average, with higher weights for recent tracks (dependent on track_idx).&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Train both versions (unweighted and weighted) on training set.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Evaluate on the test set using accuracy metrics.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Perform hypothesis test to check for significant differences (possible hypothesis: no significant difference expected).&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Goal: To assess whether weighting improves DNN performance or if the unweighted data is sufficient.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Output: Accuracy scores and p-value showing no difference.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="-819" y="293" width="812" height="196" as="geometry" />
        </mxCell>
        <mxCell id="85" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Level 3: SVD Vs. DNN&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#000000;fillColor=#FFFF66;" vertex="1" parent="1">
          <mxGeometry x="-775" y="545" width="730" height="17" as="geometry" />
        </mxCell>
        <mxCell id="86" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;Objective: To compare SVD and DNN directly to analyse their strenghts and justify a hybrid approach.&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Method:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Use SVD (default) and DNN (level 1 hyperparameters), with no further hyperparameter tuning.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;To evaluate both on the test set using accuracy metrics.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Segment data into clusters (via the method we did).&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Perform F-test on accuracy across clusters to detect significant differences.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Goal: To highlight cluster-specific performance differences and the need for a hybrid model.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Output: Accuracy scores per cluster, results from F-test and analyse the pros and cons of analysis.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="-819" y="563" width="811" height="196" as="geometry" />
        </mxCell>
        <mxCell id="87" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Level 4: Introduction of Hybrid Model&amp;nbsp;&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF8000;" vertex="1" parent="1">
          <mxGeometry x="-780" y="816" width="730" height="17" as="geometry" />
        </mxCell>
        <mxCell id="88" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;Objective: To introduce and compare a Hybrid model (SVD + DNN) against SVD and DNN respectively, shfiting focus to behavioural metrics.&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Method:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Defining Hybrid model: Combination of SVD (latent factors) and DNN (Level 1 hyperparameters).&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Train all models on training set.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;To evaluate Random, SVD, DNN and Hybrid on the test set using accuracy, Relevance (whether it match to preferences), Diversity (in items of variety), Serendipity (unexpectedness of value).&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Goal: To show potential across behavioural metrics in the Hybrid model, justifying in the shift in metrics.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Output: Scores (Accuracy, Relevance, Diversity, Serendipity), a comparison table and the rationale for dropping accuracy.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;perimeterSpacing=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="-820" y="833" width="811" height="253" as="geometry" />
        </mxCell>
        <mxCell id="89" value="&lt;font style=&quot;font-size: 10px; color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;Level 5: Cluster Analysis of Hybrid Model&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B266FF;" vertex="1" parent="1">
          <mxGeometry x="-768" y="1143" width="730" height="17" as="geometry" />
        </mxCell>
        <mxCell id="90" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;Objective: To analyse the Hybrid model&#39;s performance across clusters using behavioural metrics.&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Method:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Use Hybrid model from Level 4&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;To evaluate on the test set, segmented into clusters (same as in Level 3).&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;To compute the Relevance, Diversity and Serendipity per cluster.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Perform F-test to check for significant differences across clusters (eg. Cluster 0 has high relevance, Cluster 3 high in Diversity).&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Provide explanations for the results across the clusters.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Goal: To validate that the segmentation captures distinct behavioural patterns.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Output: Scores (Accuracy, Relevance, Diversity, Serendipity), results from F-test and explanations.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="-817" y="1160" width="810" height="253" as="geometry" />
        </mxCell>
        <mxCell id="91" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Level 6: Optimisation of Model&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#33FF33;" vertex="1" parent="1">
          <mxGeometry x="-777" y="1475" width="730" height="17" as="geometry" />
        </mxCell>
        <mxCell id="92" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 10px;&quot;&gt;Objective: To optimise the Hybrid model&#39;s weights to maximise behavioural metrics per cluster.&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Method:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Use Hybrid model from Level 5.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Tune weights on test set: Model weights and feature weights.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;To evaluate the optimised Hybrid model on final set using Relevance, Diversity and Serendipity.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;To explain the adjustments made in business terms (eg. The increased Diversity in Cluster 3 benefits engagement).&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Goal: To achieve cluster-specific optimisation and provide actionable insights.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Output: Final scores (Accuracy, Relevance, Diversity, Serendipity) for each cluster and busines insights.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="-817" y="1492" width="809" height="253" as="geometry" />
        </mxCell>
        <mxCell id="93" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1">
